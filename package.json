{
  "name": "tessellation-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/stop-stale-dev-server.cjs",
    "dev": "next dev -p 3000",
    "predev:web": "node scripts/stop-stale-dev-server.cjs",
    "dev:web": "next dev -p 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron electron/main.cjs",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "next build",
    "build:web": "next build",
    "build:desktop": "npm run build:web && electron-builder",
    "start": "next start -p 3000",
    "cap:sync": "npm run build:web && cap sync",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "clean": "rimraf .next",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.1.6",
    "pretendard": "^1.3.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": "20.x"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "rimraf": "^6.0.0"
  },
  "build": {
    "appId": "com.tessellationstudio.desktop",
    "productName": "Tessellation Studio",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
