{
  "name": "tessellation-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/stop-stale-dev-server.cjs",
    "dev": "next dev -p 3000",
    "predev:web": "node scripts/stop-stale-dev-server.cjs",
    "dev:web": "next dev -p 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron electron/main.cjs",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "next build",
    "build:web": "next build",
    "build:desktop": "npm run build:web && electron-builder",
    "start": "next start -p 3000",
    "cap:sync": "npm run build:web && cap sync",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "manuals:ppt": "node scripts/generate-user-manual-ppts.cjs",
    "clean": "rimraf .next",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "lucide-react": "1.62.0",
    "motion": "14.7.1",
    "next": "^16.4.3",
    "pretendard": "^1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "pptxgenjs": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "image-size": "2.0.4",
    "minimatch": "^10.2.1",
    "rimraf": "^6.0.0",
    "source-map-js": "1.2.2"
  },
  "build": {
    "appId": "com.tessellationstudio.desktop",
    "productName": "TStudio",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
